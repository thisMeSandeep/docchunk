---
// The docs header: the logo and "Docs" on the left; search, GitHub, and a link back home on the right.
import { Icon } from "@astrojs/starlight/components";
import Search from "@astrojs/starlight/components/Search.astro";
import { githubHref, homeHref } from "../site-links";
import DocsSiteTitle from "./DocsSiteTitle.astro";
---

<div class="docs-header">
	<DocsSiteTitle />
	<div class="docs-header-search print:hidden">
		<Search />
	</div>
	<div class="docs-header-actions sl-hidden md:sl-flex print:hidden">
		<a class="docs-header-icon" href={githubHref} aria-label="Doc-chunk on GitHub">
			<Icon name="github" size="1.25rem" />
		</a>
		<a class="docs-header-home" href={homeHref}>
			<Icon name="left-arrow" size="1rem" />
			<span>Back to home</span>
		</a>
	</div>
</div>

<style>
	.docs-header {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		height: 100%;
	}

	.docs-header-search {
		display: flex;
		flex: 1;
		justify-content: flex-end;
	}

	.docs-header-actions {
		align-items: center;
		gap: 1.25rem;
	}

	.docs-header-icon {
		display: flex;
		color: var(--sl-color-gray-3);
	}

	.docs-header-icon:hover {
		color: var(--sl-color-white);
	}

	.docs-header-home {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		height: 2.5rem;
		padding: 0 1rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 0.625rem;
		color: var(--sl-color-white);
		font-size: var(--sl-text-sm);
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
	}

	.docs-header-home:hover {
		background: rgba(255, 255, 255, 0.06);
	}
</style>
