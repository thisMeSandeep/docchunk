{
  "name": "docchunk",
  "version": "0.0.0",
  "description": "Local document chunking for RAG: PDF, Office, Markdown and text to chunks.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "bun --bun vitest run",
    "test:node": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "build": "tsup",
    "bench": "bun run bench/run.ts"
  },
  "devDependencies": {
    "@types/node": "22",
    "typescript": "5.9.3"
  }
}
